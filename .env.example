KIE_API_KEY=replace_with_kie_key
KIE_BASE_URL=https://api.kie.ai
OPENROUTER_API_KEY=replace_with_openrouter_key
SCRAPECREATORS_KEY=replace_with_scrapecreators_key
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_BUCKET=replace_with_bucket
S3_REGION=ru1
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret_key
YANDEX_DISK_TOKEN=replace_with_yandex_oauth_token
APP_STATE_KEY=default
DATABASE_URL=postgres://anton_5sec_user:replace_with_password@replace_with_host:5432/anton_5sec

TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_BOT_USERNAME=replace_with_bot_username_without_at
TELEGRAM_CLIENT_ID=replace_with_botfather_login_client_id
TELEGRAM_CLIENT_SECRET=replace_with_botfather_login_client_secret
# Optional when proxy/host detection is not enough:
# TELEGRAM_OIDC_REDIRECT_URI=https://example.com/api/auth/telegram/callback
AUTH_SESSION_SECRET=replace_with_long_random_secret
INITIAL_ADMIN_TELEGRAM_IDS=123456789
# Or use split variables instead of DATABASE_URL:
# DB_HOST=replace_with_host
# DB_PORT=5432
# DB_NAME=anton_5sec
# DB_USER=anton_5sec_user
# DB_PASSWORD=replace_with_password
# DB_SSL=false
